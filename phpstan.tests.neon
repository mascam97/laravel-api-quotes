includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest/extension.neon

parameters:

    reportUnmatchedIgnoredErrors: false

    paths:
        - tests

    # The level 9 is the highest level
    level: 8

    ignoreErrors:
        - '#Trait Tests\\CreatesApplication is used zero times and is not analysed.*#'
        - '#Access to an undefined property Pest\\PendingCalls\\TestCall::\$.*#'
        - '#Call to an undefined method Pest\\PendingCalls\\TestCall::.*#'
        - '#Access to an undefined property Pest\\Expectation.*#'
        - '#Access to an undefined property Pest\\Mixins\\Expectation.*#'
        - '#Call to an undefined method Pest\\Expectation.*#'
        - '#Cannot call method .* on .*Pest\\Expectation.*#'
        - '~Parameter #1 \$queries of function formatQueries expects array<string, string>, list<array<string, array<mixed>\|float\|string\|null>> given.~'
